{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Finalized Human-Annotated Gold Uncertainty Benchmark Schema",
  "description": "Validation schema for individual records in the authoritative 300-question gold uncertainty benchmark (Milestone 7.5.3).",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Canonical question identifier."
    },
    "question_group_id": {
      "type": "string",
      "description": "Connected-component question group ID to ensure leakage-safe cross-validation."
    },
    "question": {
      "type": "string",
      "minLength": 5,
      "description": "The natural language query string."
    },
    "category": {
      "type": "string",
      "description": "Subcategory or domain taxonomy classification."
    },
    "final_gold_label": {
      "type": "string",
      "enum": ["KNOWN", "AMBIGUOUS", "UNKNOWN"],
      "description": "The authoritative ground-truth epistemic label verified by double-blind human annotation and adjudication."
    },
    "candidate_label": {
      "type": "string",
      "enum": ["KNOWN", "AMBIGUOUS", "UNKNOWN"],
      "description": "The pre-annotation draft candidate label from benchmark v1.1."
    },
    "candidate_matches_gold": {
      "type": "boolean",
      "description": "Whether the pre-annotation candidate label coincided with final human consensus."
    },
    "source": {
      "type": "string",
      "description": "Origin of the question (e.g. natural_questions, ambignq, curated)."
    },
    "is_adversarial_variant": {
      "type": "boolean",
      "description": "Whether this query is a paired adversarial paraphrase or polysemic counter-example."
    },
    "human_annotation_provenance": {
      "type": "object",
      "properties": {
        "annotator_a": {
          "type": "object",
          "properties": {
            "blinded_id": { "type": "string", "pattern": "^ANN_A_[0-9]{3}$" },
            "assigned_label": { "type": "string", "enum": ["KNOWN", "AMBIGUOUS", "UNKNOWN"] },
            "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
            "rationale": { "type": "string" },
            "requires_adjudication": { "type": "boolean" },
            "notes": { "type": "string" }
          },
          "required": ["blinded_id", "assigned_label", "confidence", "requires_adjudication"],
          "additionalProperties": false
        },
        "annotator_b": {
          "type": "object",
          "properties": {
            "blinded_id": { "type": "string", "pattern": "^ANN_B_[0-9]{3}$" },
            "assigned_label": { "type": "string", "enum": ["KNOWN", "AMBIGUOUS", "UNKNOWN"] },
            "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
            "rationale": { "type": "string" },
            "requires_adjudication": { "type": "boolean" },
            "notes": { "type": "string" }
          },
          "required": ["blinded_id", "assigned_label", "confidence", "requires_adjudication"],
          "additionalProperties": false
        },
        "is_unanimous": { "type": "boolean" },
        "adjudication_required": { "type": "boolean" },
        "adjudication_record": {
          "type": ["object", "null"],
          "properties": {
            "docket_id": { "type": "string" },
            "trigger_reason": { "type": "string" },
            "adjudicated_label": { "type": "string", "enum": ["KNOWN", "AMBIGUOUS", "UNKNOWN"] },
            "adjudication_rationale": { "type": "string", "minLength": 5 },
            "adjudicator": { "type": "string" },
            "timestamp": { "type": "string" }
          },
          "required": ["docket_id", "trigger_reason", "adjudicated_label", "adjudication_rationale", "adjudicator", "timestamp"],
          "additionalProperties": false
        }
      },
      "required": ["annotator_a", "annotator_b", "is_unanimous", "adjudication_required", "adjudication_record"],
      "additionalProperties": false
    },
    "reviewer_agreement": {
      "type": "object",
      "properties": {
        "annotation_status": {
          "type": "string",
          "enum": ["gold_benchmark"]
        },
        "annotator_count": { "type": "integer", "minimum": 2 },
        "individual_labels": {
          "type": "array",
          "items": { "type": "string", "enum": ["KNOWN", "AMBIGUOUS", "UNKNOWN"] }
        },
        "inter_annotator_agreement": {
          "type": "string",
          "enum": ["unanimous_consensus", "adjudicated_consensus"]
        },
        "adjudicator_id": { "type": ["string", "null"] },
        "adjudication_rationale": { "type": ["string", "null"] }
      },
      "required": ["annotation_status", "annotator_count", "individual_labels", "inter_annotator_agreement"],
      "additionalProperties": false
    },
    "benchmark_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "gold_finalized_timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of gold-standard benchmark assembly."
    }
  },
  "required": [
    "id",
    "question_group_id",
    "question",
    "category",
    "final_gold_label",
    "candidate_label",
    "candidate_matches_gold",
    "source",
    "human_annotation_provenance",
    "reviewer_agreement",
    "benchmark_version",
    "gold_finalized_timestamp"
  ],
  "additionalProperties": false
}
